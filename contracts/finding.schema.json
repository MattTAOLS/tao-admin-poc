{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taosolutions.ca/tao-admin-poc/finding.schema.json",
  "title": "Validation finding",
  "description": "One rule failure (or note) produced by the rule engine for one extraction. The review card renders exactly these fields. Rules themselves live in contracts/rules.yaml.",
  "type": "object",
  "required": ["id", "extraction_id", "rule_id", "layer", "severity", "message", "status"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "extraction_id": { "type": "string", "format": "uuid" },
    "rule_id": { "type": "string", "pattern": "^R(0[1-9]|1[0-9]|2[0-2])$" },
    "layer": { "type": "string", "enum": ["structural", "arithmetic", "cross_period", "cross_source", "covenant", "reasonableness"] },
    "severity": { "type": "string", "enum": ["block", "review", "note"] },
    "message": { "type": "string", "description": "Plain-language sentence for the reviewer, already filled in with values." },
    "fields": {
      "type": "array",
      "description": "JSON pointers into extraction.deal that the rule read.",
      "items": { "type": "string" }
    },
    "our_value": { "type": ["number", "string", "boolean", "null"], "description": "What we computed or expected." },
    "report_value": { "type": ["number", "string", "boolean", "null"], "description": "What the report states (as extracted)." },
    "difference": { "type": ["number", "null"] },
    "tolerance": { "type": ["number", "null"] },
    "unit": { "type": ["string", "null"], "enum": ["currency", "percent_points", "count", "ratio", "months", "text", null] },
    "source_page": { "type": ["integer", "null"], "minimum": 1 },
    "context": {
      "type": "object",
      "description": "Rule-specific extras shown on the card, e.g. the roll-forward terms, the prior period's value, the master-data value.",
      "additionalProperties": true
    },
    "status": { "type": "string", "enum": ["open", "resolved_by_pass_2", "overridden", "accepted_as_restatement", "rejected", "closed"] },
    "resolution": {
      "type": ["object", "null"],
      "required": ["by", "at", "choice"],
      "properties": {
        "by": { "type": "string", "description": "role or user label from the role switcher" },
        "at": { "type": "string", "format": "date-time" },
        "choice": { "type": "string", "enum": ["use_ours", "use_report", "restatement", "reject", "acknowledge"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
