{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taosolutions.ca/tao-admin-poc/extraction.schema.json",
  "title": "SetRep extraction result",
  "description": "Output of the extraction worker for one SetRep. \"deal\" is the dashboard.json deal object (schema inferred from the 12 real objects in docs/dashboard-json; unchanged so the roll-up generator keeps working). \"meta\" describes the run. \"sources\" gives provenance for every leaf value written into \"deal\", keyed by JSON pointer. Missing values are null, never omitted and never zero.",
  "type": "object",
  "required": [
    "meta",
    "deal",
    "sources"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "upload_id",
        "pass",
        "template_id",
        "page_count",
        "extracted_at",
        "engine"
      ],
      "properties": {
        "upload_id": {
          "type": "string",
          "format": "uuid"
        },
        "pass": {
          "type": "integer",
          "enum": [
            1,
            2
          ],
          "description": "1 = first full extraction; 2 = targeted re-read of named pages"
        },
        "pages_reread": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "pass 2 only: the pages re-read"
        },
        "template_id": {
          "type": "string",
          "description": "extraction mapping used, e.g. fpil-2.0-settrep-v1"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "reporting_period": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}$",
          "description": "month named in the page header \"for reporting period\"; one month before collection_period under the current convention"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "engine": {
          "type": "object",
          "required": [
            "text_layer",
            "model"
          ],
          "properties": {
            "text_layer": {
              "type": "string",
              "description": "e.g. pdfplumber 0.11"
            },
            "ocr": {
              "type": [
                "string",
                "null"
              ],
              "description": "OCR engine if any page had no text layer"
            },
            "model": {
              "type": "string",
              "description": "Claude model id used for cell-to-field mapping"
            }
          }
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "deal": {
      "type": "object",
      "properties": {
        "deal_slug": {
          "type": "string"
        },
        "deal_name": {
          "type": "string"
        },
        "terminology": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "balance_label": {
              "type": "string"
            },
            "amount_label": {
              "type": "string"
            },
            "unit_label": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "required": [
            "balance_label",
            "amount_label",
            "unit_label"
          ]
        },
        "source_pages": {
          "type": "object",
          "properties": {
            "tranche_balance": {
              "type": "integer"
            },
            "tranche_amounts": {
              "type": "integer"
            },
