# Copy to .env (git-ignored). Agents never see .env; they get this file.
ANTHROPIC_API_KEY=sk-ant-...            # TAO Admin workspace key (CreditNova key works as fallback)
ANTHROPIC_MODEL=claude-sonnet-4-5       # cell-to-field mapping; override per environment
AZURE_DI_ENDPOINT=                      # optional: OCR fallback for pages with no text layer
AZURE_DI_KEY=
LOG_LEVEL=INFO

# News screening (wave E). NEWS_SECRET_KEY encrypts the client API keys stored in System settings (News sources).
# Make one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe and the same across restarts: if it changes, the stored keys must be entered again.
NEWS_SECRET_KEY=
# Model for the news check (is the story about this company, adverse or not). Uses ANTHROPIC_API_KEY.
NEWS_MODEL=claude-haiku-5-5
