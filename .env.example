# Copy to .env (git-ignored). Agents never see .env; they get this file.
ANTHROPIC_API_KEY=sk-ant-...            # TAO Admin workspace key (CreditNova key works as fallback)
ANTHROPIC_MODEL=claude-sonnet-4-5       # cell-to-field mapping; override per environment
AZURE_DI_ENDPOINT=                      # optional: OCR fallback for pages with no text layer
AZURE_DI_KEY=
LOG_LEVEL=INFO
