# Production settings. Copy to .env next to docker-compose.prod.yml and fill in. Never commit .env.

# Database login. The password takes effect when the database volume is first created; changing it here later does
# not change it inside Postgres. Use letters and digits only (it goes into a connection URL).
POSTGRES_USER=tao
POSTGRES_PASSWORD=
POSTGRES_DB=tao_admin

# Port the web server listens on, on the host. Put HTTPS in front of it: see docs/hosting.md.
HTTP_PORT=80

# API processes. 1 is plenty for a handful of users.
API_WORKERS=1

# Extraction: Claude maps report cells to fields. Use the same values as the laptop's .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: Azure Document Intelligence, the OCR fallback for pages with no text layer.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

LOG_LEVEL=INFO
