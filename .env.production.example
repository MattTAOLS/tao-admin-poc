# Production settings. Copy to .env next to docker-compose.prod.yml and fill in. Never commit .env.

# Database login. The password takes effect when the database volume is first created; changing it here later does
# not change it inside Postgres. Use letters and digits only (it goes into a connection URL).
POSTGRES_USER=tao
POSTGRES_PASSWORD=
POSTGRES_DB=tao_admin

# Port the web server listens on, on the host. Put HTTPS in front of it: see docs/hosting.md.
HTTP_PORT=80

# API processes. 1 is plenty for a handful of users.
API_WORKERS=1

# Anthropic key. Required for the news check (every story is checked by Claude). Extraction reads the PDFs itself and
# uses Claude only as a fallback for cells it cannot place. Use the same values as the laptop's .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Reserved: Azure Document Intelligence (OCR for pages with no text layer). Not used by the code yet; leave empty.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

LOG_LEVEL=INFO

# News screening. NEWS_SECRET_KEY encrypts the client API keys entered in System settings > News sources.
# Moving data from the laptop: copy the laptop's NEWS_SECRET_KEY here, so the stored keys keep working after the restore.
# Starting fresh: make one with
#   docker compose -f docker-compose.prod.yml run --rm --no-deps api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up .env somewhere safe (the backup script does not copy it). If this key is lost or changed, the stored
# news-source keys must be entered again.
NEWS_SECRET_KEY=
NEWS_MODEL=claude-haiku-5-5
